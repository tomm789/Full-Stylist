  <View style={styles.submitContainer}>
  <PrimaryButton
    title={editingEntry ? 'Update Entry' : 'Add Entry'}
    onPress={onSubmit}
    loading={saving}
    disabled={saving}
    fullWidth
  />
</View>
</ScrollView>
        </View>
      </View>
    </Modal>
  );
}

