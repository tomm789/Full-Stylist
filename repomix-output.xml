  }) => {
    const imageUrl = getImageUrl(item.image);
    const isSelected = selectedImageIds.has(item.image_id);

    return (
      <TouchableOpacity
        style={[styles.imageCard, isSelected && styles.imageCardSelected]}
        onPress={() => toggleImage(item.image_id)}
      >
        {imageUrl ? (
          <ExpoImage
