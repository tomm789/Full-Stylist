      backgroundColor: colors.background,
      justifyContent: 'center',
      alignItems: 'center',
      padding: theme.spacing.lg,
    },
    content: {
      alignItems: 'center',
      maxWidth: 320,
    },
    iconWrapper: {
      marginBottom: theme.spacing.lg,
    },
