    } finally {
      setLoading(false);
    }
  }, [userId]);

  const refresh = useCallback(async () => {
    await loadLookbooks();
  }, [loadLookbooks]);

  useEffect(() => {
    loadLookbooks();
  }, [loadLookbooks]);

  return {
    lookbooks,
    loading,
    refresh,
  };
}

export default useArchivedLookbooks;
