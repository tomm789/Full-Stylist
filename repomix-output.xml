    'ai_job_id' | 'image_id' | 'status' | 'prompt_text' | 'input_snapshot_json' | 'is_saved'
  >>
): Promise<void> {
  const { error } = await supabase
    .from('headshot_generation_variations')
    .update(updates)
    .eq('id', variationId);

  if (error) {
    console.warn('updateHeadshotGenerationVariation failed', error);
  }
}
