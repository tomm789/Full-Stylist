        dismissButtonContainer: {
          minWidth: '44px',
          minHeight: '44px',
          display: 'flex',
          alignItems: 'center' as const,
          justifyContent: 'center' as const,
          borderRadius: '22px',
          backgroundColor: 'rgba(255, 255, 255, 0.1)',
