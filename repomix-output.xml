import * as React from 'react';
import Svg, { G, Path } from 'react-native-svg';
import type { SvgProps } from 'react-native-svg';

/**
 * Hat / accessories icon (SVGRepo – hat-travel-holiday).
 * Source: assets/icons/wardrobe/hat-travel-holiday-svgrepo-com.svg
 * Original has rotate(-45); applied via G transform so hat reads clearly at small size.
 */
const SvgAccessories = (props: SvgProps) => (
  <Svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 512 512"
    fill="currentColor"
    width={24}
    height={24}
    {...props}
