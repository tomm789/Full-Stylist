        ) : imageUrl ? (
          <Image source={{ uri: imageUrl }} style={postGridStyles.gridImage} contentFit="cover" />
        ) : (
          <View style={postGridStyles.gridImagePlaceholder}>
            <Text style={styles.placeholderText}>No Image</Text>
          </View>
