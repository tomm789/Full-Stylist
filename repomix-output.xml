    marginRight: spacing.sm,
  },
  expandedRow: {
    flexDirection: 'row',
    alignItems: 'center',
    flex: 1,
    gap: spacing.sm,
  },
  expandedBackButton: {
    padding: spacing.xs,
  },
  expandedPillWrap: {
    flex: 1,
    minWidth: 0,
  },
  addButton: {
    padding: spacing.xs,
  },
});
