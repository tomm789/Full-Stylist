/**
 * Navigate to a specific wardrobe item
 */
export function navigateToWardrobeItem(
  router: ReturnType<typeof useRouter>,
  itemId: string,
  itemIds?: string
) {
  if (itemIds) {
    router.replace(`/wardrobe/item/${itemId}?itemIds=${itemIds}`);
