{
  "name": "full-stylist",
  "version": "3.1.0",
  "description": "AI styling app for creating virtual headshots and outfits",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "dev": "netlify dev",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "analyze": "expo export --platform web && source-map-explorer dist/_expo/static/js/web/*.js",
    "start:profile": "expo start --dev-client -- --profile"
  },
  "keywords": [
    "ai",
    "styling",
    "fashion",
    "virtual-stylist"
  ],
  "author": "",
  "license": "MIT",
